<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#ffffffff" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2b374a" />
            <corners android:radius="14.0dp" />
            <stroke android:width="1.5dp" android:color="#4dffffff" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121822" />
            <corners android:radius="14.0dp" />
            <stroke android:width="1.0dp" android:color="#14ffffff" />
        </shape>
    </item>
</selector>
