<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#f5ffffff" />
            <corners android:radius="21.0dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596ec1ff" />
            <stroke android:width="1.5dp" android:color="#ff6ec1ff" />
            <corners android:radius="21.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#2effffff" android:endColor="#14ffffff" android:angle="270.0" />
            <stroke android:width="1.0dp" android:color="#38ffffff" />
            <corners android:radius="21.0dp" />
        </shape>
    </item>
</selector>
