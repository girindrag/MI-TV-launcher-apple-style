<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5574a987" />
            <corners android:radius="14.0dp" />
            <stroke android:width="2.0dp" android:color="#ffb9e7c7" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#334dae6d" />
            <corners android:radius="14.0dp" />
            <stroke android:width="1.0dp" android:color="#ff4dae6d" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ff242b34" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
</selector>
